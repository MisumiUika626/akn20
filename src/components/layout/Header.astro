---
import { localizedPath, messages, type Locale } from "@/i18n/config";
import { menuLinks, siteConfig } from "@/site-config";
import { withBase } from "@/utils/path";
import ThemeToggle from "../ThemeToggle.astro";
import { authOrigin } from "@/data/auth";

interface Props {
	locale: Locale;
	switchPath?: string;
}

const { locale } = Astro.props;
const t = messages[locale];
const url = new URL(Astro.request.url);
const wordmark = siteConfig.title;
const localizedMenuPaths = new Set(["/", "/about/", "/posts/", "/projects/", "/search/", "/admin/"]);
const menuPath = (path: string) =>
	localizedMenuPaths.has(path) ? localizedPath(locale, path) : path;

const visibleMenuLinks = menuLinks;

const isActive = (path: string) => {
	const target = withBase(menuPath(path));
	if (path === "/") return url.pathname === target || url.pathname === target.replace(/\/$/, "");
	return url.pathname === target || url.pathname.startsWith(target);
};

const navIcons: Record<string, string> = {
	"/": '<path d="M2.5 6.5 8 2l5.5 4.5V13a1 1 0 0 1-1 1h-2.5v-4h-4v4H3.5a1 1 0 0 1-1-1Z"/>',
	"/posts/":
		'<path d="M3 2.5h7l3 3V13a.5.5 0 0 1-.5.5h-9.5a.5.5 0 0 1-.5-.5V3a.5.5 0 0 1 .5-.5Z"/><path d="M10 2.5V5.5h3"/><path d="M5.5 8.5h5"/><path d="M5.5 11h3.5"/>',
	"/projects/":
		'<rect x="2" y="4.5" width="12" height="8.5" rx="1"/><path d="M5.5 4.5V3a1 1 0 0 1 1-1h3a1 1 0 0 1 1 1v1.5"/>',
	"/about/":
		'<circle cx="8" cy="6" r="2.5"/><path d="M3 13c.6-2.4 2.6-3.5 5-3.5s4.4 1.1 5 3.5"/>',
	"/search/": '<circle cx="6.5" cy="6.5" r="4"/><path d="m10 10 4 4"/>',
	"/admin/": '<path d="m10 2 4 4-8 8H2v-4zM8 4l4 4"/>',
};

---

<header class="site-header" id="main-header">
		<a href={withBase(localizedPath(locale, "/"))} class="wordmark" id="site-wordmark" data-locale={locale}>{wordmark}</a>
	<div class="header-right">
			<nav class="nav" id="primary-nav" data-auth-origin={authOrigin} data-edit-path={withBase(localizedPath(locale, "/admin/"))} data-edit-label={t.nav["/admin/"]} aria-label={locale === "zh" ? "主导航" : "Primary"}>
			{
				visibleMenuLinks.map((link) => (
					<a
						aria-current={isActive(link.path) ? "page" : false}
						class:list={[{ active: isActive(link.path) }]}
						data-astro-prefetch
							href={withBase(menuPath(link.path))}
					>
						<svg
							aria-hidden="true"
							viewBox="0 0 16 16"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							stroke-linecap="round"
							stroke-linejoin="round"
							set:html={navIcons[link.path] ?? ""}
						/>
							<span>{t.nav[link.path] ?? link.title}</span>
					</a>
				))
				}
			</nav>
			<form class="header-search" action={withBase(localizedPath(locale, "/search/"))} role="search">
				<label class="sr-only" for="header-search-input">{locale === "zh" ? "搜索文章" : "Search posts"}</label>
				<input id="header-search-input" name="q" type="search" placeholder={locale === "zh" ? "搜索" : "Search"} autocomplete="off" />
				<button type="submit" aria-label={locale === "zh" ? "搜索" : "Search"}>⌕</button>
			</form>
			<ThemeToggle locale={locale} />
	</div>
</header>
<p id="wordmark-login-status" class="login-feedback" role="status" aria-live="polite" hidden></p>

<script>
	const nav = document.getElementById("primary-nav");
	const origin = nav?.dataset.authOrigin;
	const key = "akn20-owner-session";
	async function updateOwnerLink() {
		if (!nav || !origin) return;
		let token: string | null = null;
		try { token = sessionStorage.getItem(key); } catch { /* No session. */ }
		if (!token) { nav.querySelector(".owner-edit-link")?.remove(); return; }
		try {
			const res = await fetch(`${origin}/session`, { headers: { Authorization: `Bearer ${token}` }, cache: "no-store" });
			if (!res.ok || (await res.json()).id !== 245514160 || sessionStorage.getItem(key) !== token) {
				nav.querySelector(".owner-edit-link")?.remove(); return;
			}
			if (!nav.querySelector(".owner-edit-link")) {
				const link = document.createElement("a");
				link.className = "owner-edit-link";
				link.href = nav.dataset.editPath ?? "";
				link.textContent = nav.dataset.editLabel ?? "Edit";
				nav.append(link);
			}
		} catch { nav.querySelector(".owner-edit-link")?.remove(); }
	}
	document.addEventListener("akn20-session-change", () => { void updateOwnerLink(); });
	void updateOwnerLink();

	const wordmark = document.getElementById("site-wordmark") as HTMLAnchorElement | null;
	const feedback = document.getElementById("wordmark-login-status");
	const zh = wordmark?.dataset.locale === "zh";
	let clicks = 0;
	let navigationTimer: ReturnType<typeof setTimeout> | undefined;
	let loginPopup: Window | null = null;
	const say = (text: string) => {
		if (feedback) { feedback.hidden = false; feedback.textContent = text; }
	};
	wordmark?.addEventListener("click", (event) => {
		if (!origin || !nav || event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		// Keyboard activation keeps the link's normal behavior. Pointer clicks wait
		// briefly so the first click cannot navigate away before a triple click.
		if (event.detail === 0 && !(event as PointerEvent).pointerType) return;
		event.preventDefault();
		if (navigationTimer) clearTimeout(navigationTimer);
		clicks++;
		if (clicks < 3) {
			navigationTimer = setTimeout(() => { clicks = 0; window.location.assign(wordmark.href); }, 450);
			return;
		}
		clicks = 0;
		loginPopup = window.open(`${origin}/auth`, "akn20-wordmark-login", "popup,width=600,height=720");
		if (!loginPopup) {
			window.location.assign(nav.dataset.editPath ?? wordmark.href);
			return;
		}
		say(zh ? "请在 GitHub 窗口完成作者登录。" : "Complete owner sign-in in the GitHub window.");
	});
	window.addEventListener("message", async (event: MessageEvent) => {
		if (!origin || !nav || !loginPopup || event.origin !== origin || event.source !== loginPopup || !event.data || event.data.type !== "akn20-auth") return;
		loginPopup = null;
		if (typeof event.data.token !== "string") {
			say(event.data.error === "forbidden" ? (zh ? "该账号没有作者权限。" : "This account is not the owner.") : (zh ? "登录未完成，请重试。" : "Sign-in did not complete. Please try again."));
			return;
		}
		try {
			const result = await fetch(`${origin}/session`, { headers: { Authorization: `Bearer ${event.data.token}` }, cache: "no-store" });
			if (!result.ok || (await result.json()).id !== 245514160) throw new Error("Unauthorized");
			sessionStorage.setItem(key, event.data.token);
			document.dispatchEvent(new Event("akn20-session-change"));
			window.location.assign(nav.dataset.editPath ?? wordmark?.href ?? "/");
		} catch { say(zh ? "登录验证失败，请重试。" : "Sign-in verification failed. Please try again."); }
	});
</script>

<style>
	.site-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 72px;
	}
	.wordmark {
		min-width: 0;
		overflow-wrap: anywhere;
		touch-action: manipulation;
		user-select: none;
		font-family: var(--type-header-wordmark-family);
		font-size: var(--type-header-wordmark-size);
		font-weight: var(--type-header-wordmark-weight);
		line-height: var(--type-header-wordmark-line-height);
		letter-spacing: var(--type-header-wordmark-tracking);
		color: hsl(var(--theme-text));
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	.wordmark:hover {
		color: hsl(var(--theme-accent));
	}
	.login-feedback {
		font-family: var(--font-sans);
		font-size: 13px;
		padding: 12px 16px;
		border: 1px solid var(--hairline);
		border-radius: 4px;
		color: hsl(var(--theme-text-muted));
		margin: 0 0 24px;
	}
	.header-right {
		display: flex;
		align-items: center;
		gap: 16px;
	}
	.header-search { display: flex; align-items: stretch; width: 174px; height: 32px; }
	.header-search input { min-width: 0; width: 100%; border: 1px solid var(--hairline); border-right: 0; border-radius: 4px 0 0 4px; padding: 6px 9px; background: hsl(var(--theme-bg)); color: hsl(var(--theme-text)); font: 12px var(--font-sans); }
	.header-search button { flex: 0 0 32px; border: 1px solid var(--hairline); border-radius: 0 4px 4px 0; background: var(--accent-soft); color: hsl(var(--theme-text-muted)); cursor: pointer; }
	.sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
	.nav {
		display: flex;
		align-items: baseline;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 22px;
		font-family: var(--type-header-nav-family);
		font-size: var(--type-header-nav-size);
		font-weight: var(--type-header-nav-weight);
		line-height: var(--type-header-nav-line-height);
		letter-spacing: var(--type-header-nav-tracking);
		color: hsl(var(--theme-text) / 0.72);
	}
	.nav a {
		display: inline-block;
		flex: 0 0 auto;
		white-space: nowrap;
		position: relative;
		padding-bottom: 3px;
		transition: color 0.2s ease;
	}
	/* Indicator overhangs the text slightly so the underline isn't abrupt. */
	.nav a::after {
		content: "";
		position: absolute;
		left: -3px;
		right: -3px;
		bottom: 0;
		height: 1px;
		background: transparent;
	}
	.nav a svg {
		display: inline-block;
		width: 14px;
		height: 14px;
		stroke: currentColor;
		vertical-align: -2px;
		margin-right: 6px;
	}
	.nav a:hover {
		color: hsl(var(--theme-accent));
	}
	.nav a.active {
		color: hsl(var(--theme-text));
	}
	.nav a.active::after {
		background: hsl(var(--theme-accent));
	}

	@media (max-width: 720px) {
		.site-header {
			margin-bottom: 36px;
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-areas:
				"wordmark theme"
				"search search"
				"nav nav";
			align-items: center;
			column-gap: 14px;
			row-gap: 14px;
		}
		.wordmark { grid-area: wordmark; }
		.header-right { display: contents; }
		.theme-toggle { grid-area: theme; justify-self: end; }
		.header-search { grid-area: search; width: 100%; }
		.nav {
			grid-area: nav;
			gap: 22px;
			font-size: var(--type-header-nav-size);
			justify-content: flex-start;
		}
		.nav a {
			/* Add top tap padding; desktop rule keeps the indicator space below. */
			padding-top: 6px;
		}
		.nav a svg {
			width: 13px;
			height: 13px;
		}
	}

	@media (max-width: 420px) {
		.site-header {
			margin-bottom: 28px;
			row-gap: 12px;
		}
		.wordmark {
			font-size: var(--type-header-wordmark-size);
		}
		.nav {
			gap: 12px;
			font-size: var(--type-header-nav-size);
		}
		.nav a svg {
			display: none;
		}
	}
</style>
